.venv/
__pycache__/
*.pyc
.env
.pytest_cache/
data/processed/embeddings/*.npy
data/processed/faiss_index/*.faiss

# Source PDFs are copyrighted books -- don't push them, or any full-text
# derived from them, to the public repo. Drop PDFs in data/raw/ locally and
# run the pipeline scripts to regenerate everything below from scratch;
# data/raw/sources_manifest.csv (metadata only, no book text) still gets
# committed for provenance.
data/raw/*.pdf
data/raw/text/
data/processed/chunks.jsonl
data/eval/demo_cache.json
data/processed/faiss_index/id_map.json
# KG build intermediates that quote book sentences. The LLM results
# (entity_types.json, extracted.jsonl: names + relations + page only) are kept.
data/kg_build/mentions.json
data/kg_build/candidates.jsonl
data/kg_build/draft_cache.json
data/kg_build/review_facts.csv
.DS_Store
